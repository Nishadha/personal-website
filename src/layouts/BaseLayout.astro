---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Your Name — Digital Marketing Consultant',
  description = 'Independent digital marketing strategy and growth consulting.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
